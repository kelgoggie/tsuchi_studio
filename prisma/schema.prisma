// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Period {
  MORNING // 9:00–12:00
  AFTERNOON // 1:00–4:00
  EVENING // 4:00–7:00
}

enum BookingStatus {
  PENDING // submitted, awaiting payment/receipt
  CONFIRMED // receipt verified by admin
  CANCELLED
}

// How the customer wants their invoice / proof-of-payment thread to happen.
enum InvoiceVia {
  EMAIL
  INSTAGRAM
}

// A workshop type and its per-session capacity rule.
model Workshop {
  id          String      @id @default(cuid())
  slug        String      @unique // "wheel-throwing"
  name        String
  description String?
  durationMin Int         @default(180)
  capacity    Int // max participants per session
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  bookings    Booking[]
  slotBlocks  SlotBlock[]
}

// A customer's booking for a workshop on a specific date + session.
model Booking {
  id         String        @id @default(cuid())
  workshop   Workshop      @relation(fields: [workshopId], references: [id])
  workshopId String
  date       DateTime      @db.Date
  period     Period
  partySize  Int           @default(1)
  name       String
  // The customer picks how we reach them, so exactly one of these is required —
  // enforced in the booking API, not by the DB.
  email      String?
  instagram  String?
  invoiceVia InvoiceVia    @default(EMAIL)
  phone      String?
  notes      String?
  bookingFee Int? // the full class fee, paid upfront
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  emailMarks EmailMark[]

  @@index([date, period, workshopId])
}

// One row per email button the admin has composed for a booking — drives the
// pressed/sage tint on the email buttons, shared across devices and sessions.
model EmailMark {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  kind      String // request | confirmation | expired | filled
  createdAt DateTime @default(now())

  @@unique([bookingId, kind])
}

// Slots the studio holds back for a specific workshop/date/session, without a
// real customer booking. Availability subtracts these from capacity.
model SlotBlock {
  id         String   @id @default(cuid())
  workshop   Workshop @relation(fields: [workshopId], references: [id])
  workshopId String
  date       DateTime @db.Date
  period     Period
  slots      Int
  reason     String?
  createdAt  DateTime @default(now())

  @@index([date, period, workshopId])
}

// Days (or a single session) the studio blocks off — holidays, one-off closures.
model Closure {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  period Period? // null = whole day closed
  reason String?

  @@unique([date, period])
}

// Overrides the default "closed on Mondays" rule — the studio IS open this day.
model Opening {
  id     String   @id @default(cuid())
  date   DateTime @unique @db.Date
  reason String?
}

// Shop items, managed from the admin.
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  imageUrls   String[]
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}
